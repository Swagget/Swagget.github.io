# Notion internal integration token (starts with "secret_" or "ntn_")
NOTION_TOKEN=

# Notion database ID (32-char hex from the DB URL)
NOTION_DATABASE_ID=

# Projects database ID (32-char hex from the DB URL)
NOTION_PROJECTS_DATABASE_ID=

# Where generated posts and images land (relative to notion-sync/)
OUTPUT_DIR=../_posts
IMAGE_DIR=../images/posts
FILE_DIR=../files/posts

# Where generated projects and images land (relative to notion-sync/)
PROJECTS_OUTPUT_DIR=../_projects
PROJECTS_IMAGE_DIR=../images/projects
PROJECTS_FILE_DIR=../files/projects
